# ──────────────────────────────────────────────────────────────────────────────
# A Muslim Matchmaker — local development environment
# Copy to `.env` and fill in. For production see `.env.production.example`.
# Never commit real secrets.
# ──────────────────────────────────────────────────────────────────────────────

# ── Django core ───────────────────────────────────────────────────────────────
# DEBUG defaults to False; local dev must opt in. SECRET_KEY is required when
# DEBUG=False (it also signs JWTs).
DEBUG=True
SECRET_KEY=<generate: python -c "import secrets; print(secrets.token_urlsafe(50))">
ALLOWED_HOSTS=localhost,127.0.0.1

# ── URLs ──────────────────────────────────────────────────────────────────────
BASE_URL=http://localhost:8001
FRONTEND_URL=http://localhost:5173
FRONTEND_LOGIN_SUCCESS_URL=http://localhost:5173/login/success
FRONTEND_LOGIN_ERROR_URL=http://localhost:5173/login/error

# Comma-separated browser origins (admin dashboard). Empty + DEBUG=True → allow all.
CORS_ALLOWED_ORIGINS=

# ── Database (SQLite when DB_ENGINE is unset) ─────────────────────────────────
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=amm
# DB_USER=amm
# DB_PASSWORD=<password>
# DB_HOST=localhost
# DB_PORT=5432

# ── Redis (cache, Celery broker, Channels) ────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Storage (local media/ when USE_S3 is not True) ────────────────────────────
USE_S3=False
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=eu-north-1

# ── Email (OTP, password reset, admin login) ──────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=<your-smtp-user>
EMAIL_HOST_PASSWORD=<your-smtp-app-password>
DEFAULT_FROM_EMAIL=A Muslim Matchmaker <no-reply@example.com>
SUPPORT_EMAIL=support@example.com

# ── OTP / token timings (seconds) ─────────────────────────────────────────────
OTP_EXPIRY_SECONDS=300
PASSWORD_RESET_OTP_EXPIRY_SECONDS=600
PASSWORD_RESET_TOKEN_EXPIRY_SECONDS=900

# ── Rate limits for auth endpoints (DRF format, per client IP) ────────────────
THROTTLE_RATE_OTP=10/min
THROTTLE_RATE_AUTH=20/min
# Reverse proxies in front of Django (nginx = 1). Use 0 when hitting Django directly.
DRF_NUM_PROXIES=1

# ── Social login ──────────────────────────────────────────────────────────────
GOOGLE_WEB_CLIENT_ID=<google-oauth-web-client-id>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
APPLE_CLIENT_ID=<apple-service-or-bundle-id>

# ── In-App Purchases (subscriptions app) ─────────────────────────────────────
# App Store Connect → Apps → A Muslim Matchmaker → App Information → App-Specific Shared Secret
APPLE_SHARED_SECRET=
APPLE_BUNDLE_ID=com.muslimmatchmaker.app
# Google Cloud service account JSON key, granted "View financial data" +
# "Manage orders and subscriptions" in Play Console → Users and permissions
GOOGLE_PLAY_PACKAGE_NAME=com.muslimmatchmaker.app
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=/app/secrets/google-play-service-account.json
# Optional: random string; Pub/Sub push URL becomes .../google/notifications/?token=<value>
GOOGLE_RTDN_TOKEN=
