####################################################################
# AMM (A Muslim Matchmaker) — Production Environment Variables
# 
# HOW TO USE:
#   1. Copy this file to your EC2 server:  ~/.env.production
#   2. Fill in ALL values below (replace every <PLACEHOLDER>)
#   3. In ~/amm-backend/ on EC2, symlink or copy it:
#      cp ~/.env.production ~/amm-backend/.env.production
#
# NEVER commit the real .env.production to git.
# This example file IS safe to commit (no real secrets here).
####################################################################


# ── Django Core ──────────────────────────────────────────────────────────────
# Generate a new secret key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=<YOUR_STRONG_SECRET_KEY_HERE>

# IMPORTANT: Set this to False in production
DEBUG=False

# Add your Elastic IP and EC2 public DNS here.
# After domain setup, add your domain too (e.g., amuslimmatrimony.com,www.amuslimmatrimony.com)
ALLOWED_HOSTS=<YOUR_ELASTIC_IP>,<YOUR_EC2_PUBLIC_DNS>


# ── Application URLs ──────────────────────────────────────────────────────────
# Use your Elastic IP until you get a domain
BASE_URL=http://<YOUR_ELASTIC_IP>
FRONTEND_URL=<YOUR_FRONTEND_URL>


# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<YOUR_GOOGLE_CLIENT_SECRET>
GOOGLE_REDIRECT_URI=http://<YOUR_ELASTIC_IP>/api/auth/google/callback/
GOOGLE_WEB_CLIENT_ID=<YOUR_GOOGLE_WEB_CLIENT_ID>


# ── Frontend OAuth redirect URLs ──────────────────────────────────────────────
FRONTEND_LOGIN_ERROR_URL=<YOUR_FRONTEND_URL>/login?error=oauth_failed
FRONTEND_LOGIN_SUCCESS_URL=<YOUR_FRONTEND_URL>/login?success=true


# ── Apple OAuth ───────────────────────────────────────────────────────────────
APPLE_CLIENT_ID=<YOUR_APPLE_CLIENT_ID>


# ── Redis ─────────────────────────────────────────────────────────────────────
# Keep as 'redis' — this is the Docker service name (internal network)
REDIS_HOST=redis
REDIS_PORT=6379


# ── Database (AWS RDS PostgreSQL) ─────────────────────────────────────────────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=<YOUR_RDS_DB_NAME>
DB_USER=<YOUR_RDS_MASTER_USERNAME>
DB_PASSWORD=<YOUR_RDS_MASTER_PASSWORD>
# RDS endpoint from AWS Console (looks like: amm-db.xxxxxxxxxxxx.eu-north-1.rds.amazonaws.com)
DB_HOST=<YOUR_RDS_ENDPOINT>
DB_PORT=5432


# ── AWS S3 (Media Files) ──────────────────────────────────────────────────────
# Set USE_S3=True to enable S3 media storage (required for production)
USE_S3=True
AWS_ACCESS_KEY_ID=<YOUR_IAM_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<YOUR_IAM_SECRET_ACCESS_KEY>
# Bucket name (e.g.: amm-media-eu-north-1)
AWS_STORAGE_BUCKET_NAME=<YOUR_S3_BUCKET_NAME>
AWS_S3_REGION_NAME=eu-north-1


# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=<YOUR_GMAIL_ADDRESS>
# Use a Gmail App Password (not your regular Gmail password)
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_HOST_PASSWORD=<YOUR_GMAIL_APP_PASSWORD>
DEFAULT_FROM_EMAIL=A Muslim Matchmaker <noreply@amuslimmatrimony.com>


# ── CORS (Cross-Origin Resource Sharing) ──────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slashes)
# Example: http://13.61.142.224,https://amuslimmatrimony.com
CORS_ALLOWED_ORIGINS=http://<YOUR_ELASTIC_IP>,<YOUR_FRONTEND_URL>


# ── OTP / Token Lifetimes ─────────────────────────────────────────────────────
OTP_EXPIRY_SECONDS=300
PASSWORD_RESET_OTP_EXPIRY_SECONDS=600
PASSWORD_RESET_TOKEN_EXPIRY_SECONDS=900
LAST_ACTIVE_UPDATE_INTERVAL=120


# ── iOS In-App Purchase ───────────────────────────────────────────────────────
IOS_SHARED_SECRET=<YOUR_IOS_SHARED_SECRET>
IOS_SANDBOX_MODE=False


# ── Android ───────────────────────────────────────────────────────────────────
ANDROID_PACKAGE_NAME=<YOUR_ANDROID_PACKAGE_NAME>
